{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit(frontend/src/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.tsx)",
      "Edit(frontend/src/test/*Fixture.ts)",
      "Edit(backend/tests/**)",
      "Edit(.test-agent/report.json)",
      "Write(frontend/src/**/*.test.ts)",
      "Write(frontend/src/**/*.test.tsx)",
      "Write(frontend/src/test/*Fixture.ts)",
      "Write(backend/tests/**)",
      "Write(.test-agent/report.json)",
      "Bash(bash .claude/skills/run-tests-and-coverage/scripts/run-tests.sh *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git/config)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(scripts/**)",
      "Edit(**/package.json)",
      "Edit(**/package-lock.json)",
      "Edit(**/vite.config.ts)",
      "Edit(**/vitest.config.ts)",
      "Edit(frontend/src/test/setup.ts)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(env *)",
      "Bash(printenv *)"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1"
  }
}
